{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sandesh",
  "version": "0.1.0",
  "identifier": "dev.sandesh.desktop",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local mail server for developers",
    "longDescription": "Sandesh captures mail your application sends and lets you inspect it over SMTP, IMAP, POP3, a REST API and a web UI."
  }
}
